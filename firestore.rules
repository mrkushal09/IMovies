rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'majedarsab@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Entity Blueprint Validation Helpers (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'city', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'city', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 50 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 24)) &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.grantedAt is timestamp;
    }

    function isValidMovie(data) {
      return data.keys().hasAll([
          'title', 'synopsis', 'genre', 'language', 'format', 'certificate',
          'durationMins', 'rating', 'votesCount', 'releaseDate', 'director',
          'castSummary', 'posterUrl', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'synopsis', 'genre', 'language', 'format', 'certificate',
          'durationMins', 'rating', 'votesCount', 'releaseDate', 'director',
          'castSummary', 'posterUrl', 'backdropUrl', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.synopsis is string && data.synopsis.size() >= 10 && data.synopsis.size() <= 1200 &&
        data.genre is string && data.genre.size() >= 2 && data.genre.size() <= 60 &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 40 &&
        data.format is string && data.format.size() >= 2 && data.format.size() <= 40 &&
        data.certificate in ['U', 'UA', 'UA 13+', 'UA 16+', 'A'] &&
        data.durationMins is number && data.durationMins >= 30 && data.durationMins <= 360 &&
        data.rating is number && data.rating >= 0 && data.rating <= 10 &&
        data.votesCount is number && data.votesCount >= 0 &&
        data.releaseDate is string && data.releaseDate.size() >= 8 && data.releaseDate.size() <= 20 &&
        data.director is string && data.director.size() >= 2 && data.director.size() <= 80 &&
        data.castSummary is string && data.castSummary.size() >= 2 && data.castSummary.size() <= 240 &&
        data.posterUrl is string && data.posterUrl.size() >= 1 && data.posterUrl.size() <= 500 &&
        (!('backdropUrl' in data) || (data.backdropUrl is string && data.backdropUrl.size() <= 500)) &&
        data.status in ['now_showing', 'coming_soon', 'archived'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTheatre(data) {
      return data.keys().hasAll(['name', 'city', 'address', 'amenities', 'screensCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'city', 'address', 'amenities', 'screensCount', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 50 &&
        data.address is string && data.address.size() >= 5 && data.address.size() <= 240 &&
        data.amenities is string && data.amenities.size() >= 2 && data.amenities.size() <= 200 &&
        data.screensCount is number && data.screensCount >= 1 && data.screensCount <= 30 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShow(data) {
      return data.keys().hasAll([
          'movieId', 'movieTitle', 'theatreId', 'theatreName', 'city', 'screenName',
          'format', 'language', 'showDate', 'showTime', 'classicPrice', 'primePrice',
          'reclinerPrice', 'totalSeats', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'movieId', 'movieTitle', 'theatreId', 'theatreName', 'city', 'screenName',
          'format', 'language', 'showDate', 'showTime', 'classicPrice', 'primePrice',
          'reclinerPrice', 'totalSeats', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.movieId) &&
        data.movieTitle is string && data.movieTitle.size() >= 1 && data.movieTitle.size() <= 120 &&
        isValidId(data.theatreId) &&
        data.theatreName is string && data.theatreName.size() >= 2 && data.theatreName.size() <= 120 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 50 &&
        data.screenName is string && data.screenName.size() >= 2 && data.screenName.size() <= 60 &&
        data.format is string && data.format.size() >= 2 && data.format.size() <= 40 &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 40 &&
        data.showDate is string && data.showDate.size() == 10 && data.showDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.showTime is string && data.showTime.size() >= 4 && data.showTime.size() <= 12 &&
        data.classicPrice is number && data.classicPrice >= 50 && data.classicPrice <= 5000 &&
        data.primePrice is number && data.primePrice >= 50 && data.primePrice <= 5000 &&
        data.reclinerPrice is number && data.reclinerPrice >= 50 && data.reclinerPrice <= 5000 &&
        data.totalSeats is number && data.totalSeats >= 20 && data.totalSeats <= 300 &&
        data.status in ['scheduled', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSeatReservation(data) {
      return data.keys().hasAll(['seatCode', 'tier', 'price', 'showId', 'bookingId', 'userId', 'status', 'createdAt']) &&
        data.keys().hasOnly(['seatCode', 'tier', 'price', 'showId', 'bookingId', 'userId', 'status', 'createdAt']) &&
        data.seatCode is string && data.seatCode.size() >= 2 && data.seatCode.size() <= 6 && data.seatCode.matches('^[A-Z][0-9]{1,2}$') &&
        data.tier in ['classic', 'prime', 'recliner'] &&
        data.price is number && data.price >= 50 && data.price <= 5000 &&
        isValidId(data.showId) &&
        isValidId(data.bookingId) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.status == 'booked' &&
        data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
          'userId', 'showId', 'movieId', 'movieTitle', 'posterUrl', 'theatreName',
          'city', 'screenName', 'format', 'showDate', 'showTime', 'seatCodes',
          'seatCount', 'subtotalAmount', 'convenienceFee', 'totalAmount',
          'paymentId', 'bookingCode', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'showId', 'movieId', 'movieTitle', 'posterUrl', 'theatreName',
          'city', 'screenName', 'format', 'showDate', 'showTime', 'seatCodes',
          'seatCount', 'subtotalAmount', 'convenienceFee', 'totalAmount',
          'paymentId', 'bookingCode', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.showId) &&
        isValidId(data.movieId) &&
        data.movieTitle is string && data.movieTitle.size() >= 1 && data.movieTitle.size() <= 120 &&
        data.posterUrl is string && data.posterUrl.size() >= 1 && data.posterUrl.size() <= 500 &&
        data.theatreName is string && data.theatreName.size() >= 2 && data.theatreName.size() <= 120 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 50 &&
        data.screenName is string && data.screenName.size() >= 2 && data.screenName.size() <= 60 &&
        data.format is string && data.format.size() >= 2 && data.format.size() <= 40 &&
        data.showDate is string && data.showDate.size() == 10 && data.showDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.showTime is string && data.showTime.size() >= 4 && data.showTime.size() <= 12 &&
        data.seatCodes is list && data.seatCodes.size() >= 1 && data.seatCodes.size() <= 10 &&
        data.seatCodes[0] is string && data.seatCodes[0].size() >= 2 && data.seatCodes[0].size() <= 6 &&
        data.seatCount is number && data.seatCount == data.seatCodes.size() &&
        data.subtotalAmount is number && data.subtotalAmount >= 50 && data.subtotalAmount <= 50000 &&
        data.convenienceFee is number && data.convenienceFee >= 0 && data.convenienceFee <= 5000 &&
        data.totalAmount is number && data.totalAmount == data.subtotalAmount + data.convenienceFee &&
        isValidId(data.paymentId) &&
        data.bookingCode is string && data.bookingCode.size() >= 6 && data.bookingCode.size() <= 24 && data.bookingCode.matches('^[A-Z0-9\\-]+$') &&
        data.status in ['confirmed', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPayment(data) {
      return data.keys().hasAll([
          'userId', 'bookingId', 'amount', 'currency', 'method',
          'transactionRef', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'bookingId', 'amount', 'currency', 'method',
          'transactionRef', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.bookingId) &&
        data.amount is number && data.amount >= 50 && data.amount <= 55000 &&
        data.currency in ['INR', 'USD'] &&
        data.method in ['upi', 'card', 'netbanking', 'wallet'] &&
        data.transactionRef is string && data.transactionRef.size() >= 6 && data.transactionRef.size() <= 64 && data.transactionRef.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.status in ['succeeded', 'refunded'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'title', 'message', 'type', 'read', 'relatedBookingId', 'createdAt', 'updatedAt']) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.message is string && data.message.size() >= 4 && data.message.size() <= 400 &&
        data.type in ['booking_confirmed', 'booking_cancelled', 'system'] &&
        data.read is bool &&
        (!('relatedBookingId' in data) || isValidId(data.relatedBookingId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------

    // Connection Probe Path (Read-only single doc verification)
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // 1. Public User Profile (No PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublic(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublic(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'city', 'updatedAt'])
        );
      allow delete: if false;

      // 2. Split Collection for Isolated User PII
      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;
        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          docId == 'info' &&
          isValidUserPrivate(incoming()) &&
          incoming().uid == userId &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          docId == 'info' &&
          isValidUserPrivate(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt'])
          );
        allow delete: if false;
      }
    }

    // 3. Trusted Admins Table
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == adminId &&
        incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    // 4. Movies Catalog (Public Discovery, Admin Write)
    match /movies/{movieId} {
      allow get: if isValidId(movieId) && (resource.data.status in ['now_showing', 'coming_soon'] || isAdmin());
      allow list: if resource.data.status in ['now_showing', 'coming_soon'] || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(movieId) &&
        isValidMovie(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || !exists(/databases/$(database)/documents/movies/$(movieId)));
      allow update: if isAdmin() &&
        isValidId(movieId) &&
        isValidMovie(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'synopsis', 'genre', 'language', 'format', 'certificate',
          'durationMins', 'rating', 'votesCount', 'releaseDate', 'director',
          'castSummary', 'posterUrl', 'backdropUrl', 'status', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(movieId);
    }

    // 5. Theatres Catalog (Public Discovery, Admin Write)
    match /theatres/{theatreId} {
      allow get: if isValidId(theatreId) && resource.data.screensCount >= 1;
      allow list: if resource.data.screensCount >= 1;
      allow create: if isVerifiedUser() &&
        isValidId(theatreId) &&
        isValidTheatre(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || !exists(/databases/$(database)/documents/theatres/$(theatreId)));
      allow update: if isAdmin() &&
        isValidId(theatreId) &&
        isValidTheatre(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'city', 'address', 'amenities', 'screensCount', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(theatreId);
    }

    // 6. Shows Schedule (Public Discovery, Relational Sync to Movie & Theatre)
    match /shows/{showId} {
      allow get: if isValidId(showId) && (resource.data.status == 'scheduled' || isAdmin());
      allow list: if resource.data.status == 'scheduled' || isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(showId) &&
        isValidShow(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/movies/$(incoming().movieId)) &&
        existsAfter(/databases/$(database)/documents/theatres/$(incoming().theatreId)) &&
        (isAdmin() || !exists(/databases/$(database)/documents/shows/$(showId)));
      allow update: if isAdmin() &&
        isValidId(showId) &&
        isValidShow(incoming()) &&
        incoming().movieId == existing().movieId &&
        incoming().theatreId == existing().theatreId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'screenName', 'format', 'language', 'showDate', 'showTime',
          'classicPrice', 'primePrice', 'reclinerPrice', 'totalSeats', 'status', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(showId);

      // 7. Subcollection: Per-Seat Reservation Locks (Master Gate + Atomic Booking Sync)
      match /seats/{seatId} {
        allow get: if isValidId(showId) && isValidId(seatId) && resource.data.status == 'booked' &&
          exists(/databases/$(database)/documents/shows/$(showId));
        allow list: if resource.data.status == 'booked';
        allow create: if isVerifiedUser() &&
          isValidId(showId) &&
          isValidId(seatId) &&
          isValidSeatReservation(incoming()) &&
          seatId == incoming().seatCode &&
          incoming().showId == showId &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/shows/$(showId)).data.status == 'scheduled' &&
          existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
          getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.userId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.status == 'confirmed';
        allow update: if false;
        allow delete: if isVerifiedUser() &&
          isValidId(showId) &&
          isValidId(seatId) &&
          exists(/databases/$(database)/documents/shows/$(showId)) &&
          (
            isAdmin() ||
            (
              existing().userId == request.auth.uid &&
              getAfter(/databases/$(database)/documents/bookings/$(existing().bookingId)).data.status == 'cancelled'
            )
          );
      }
    }

    // 8. Bookings (Owner/Admin Isolated, Atomic Payment Sync, Terminal State Lock)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().status == 'confirmed' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/shows/$(incoming().showId)).data.status == 'scheduled' &&
        existsAfter(/databases/$(database)/documents/payments/$(incoming().paymentId)) &&
        getAfter(/databases/$(database)/documents/payments/$(incoming().paymentId)).data.bookingId == bookingId &&
        getAfter(/databases/$(database)/documents/payments/$(incoming().paymentId)).data.userId == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().showId == existing().showId &&
        incoming().movieId == existing().movieId &&
        incoming().paymentId == existing().paymentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(existing().userId) &&
            existing().status == 'confirmed' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // 9. Payments (Owner/Admin Isolated, Atomic Booking Sync, Terminal Refund Lock)
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        incoming().status == 'succeeded' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)) &&
        getAfter(/databases/$(database)/documents/bookings/$(incoming().bookingId)).data.userId == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidId(paymentId) &&
        isValidPayment(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().bookingId == existing().bookingId &&
        incoming().amount == existing().amount &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(existing().userId) &&
            existing().status == 'succeeded' &&
            incoming().status == 'refunded' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
            getAfter(/databases/$(database)/documents/bookings/$(existing().bookingId)).data.status == 'cancelled'
          )
        );
      allow delete: if false;
    }

    // 10. Notifications (Owner Isolated)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isOwner(resource.data.userId) || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(existing().userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && (isOwner(existing().userId) || isAdmin());
    }
  }
}
